{
  "name": "@kyxos/render-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Stable public product-facing Kyxos Render Engine SDK.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./static-accumulation": {
      "types": "./dist/static-accumulation.d.ts",
      "import": "./dist/static-accumulation.js",
      "default": "./dist/static-accumulation.js"
    }
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@kyxos/render-backend-api": "workspace:*",
    "@kyxos/render-backend-webgpu": "workspace:*",
    "@kyxos/render-camera": "workspace:*",
    "@kyxos/render-core": "workspace:*",
    "@kyxos/render-environment": "workspace:*",
    "@kyxos/render-frame-scheduler": "workspace:*",
    "@kyxos/render-geometry": "workspace:*",
    "@kyxos/render-material-core": "workspace:*",
    "@kyxos/render-material-pbr": "workspace:*",
    "@kyxos/render-math": "workspace:*",
    "@kyxos/render-renderer": "workspace:*",
    "@kyxos/render-scene": "workspace:*",
    "@kyxos/render-temporal": "workspace:*",
    "@kyxos/render-visibility": "workspace:*"
  },
  "devDependencies": {
    "@kyxos/render-testing": "workspace:*"
  }
}
