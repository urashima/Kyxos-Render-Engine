{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "playwright*.config.ts",
    "vitest.config.ts"
  ]
}
