{
  "name": "@kyxos/render-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent Kyxos Render Engine development and acceptance playground.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit --pretty false -p tsconfig.json && vite build",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json"
  },
  "dependencies": {
    "@kyxos/render-sdk": "workspace:*",
    "@kyxos/render-testing": "workspace:*"
  },
  "devDependencies": {
    "vite": "8.1.3"
  }
}
